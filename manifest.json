{
  "manifest_version": 3,
  "name": "InstantBranding",
  "version": "1.0.0",
  "description": "Your Banner Buddy.",
  "action": {},
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/content/index.tsx"
      ]
    }
  ]
}